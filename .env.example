# Configuration AWS. Copier ce fichier en .env.local.
# Ne jamais commiter de clés : .env.local est ignoré par git.

AWS_REGION=us-east-1
DYNAMODB_TABLE=aidants

# Clés de l'utilisateur IAM `gameday-user` (accès programmatique).
# Alternative sans clés dans le fichier : laisser vides et définir AWS_PROFILE=gameday.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Uniquement si vous utilisez des clés temporaires (ASIA...). Sinon, laisser vide.
AWS_SESSION_TOKEN=

# --- IA (Amazon Bedrock, toujours en us-east-1) ---
# `bedrock` : embeddings + Guardrails. `rules` : tout en local (tags, règles), sans appel AWS.
# Si Bedrock est injoignable, l'application bascule seule sur les règles locales.
AI_MODE=bedrock
# Modèle d'embeddings (512 dimensions normalisées).
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
# --- Modération (voir README « Modération avant publication ») ---
# Garde-fou binaire (sujet « conseil médical », liste de mots), créé par `npm run ai:guardrail`. Vide = l'identifiant
# mémorisé en base, sinon ce niveau est ignoré (les scores InvokeGuardrailChecks n'ont besoin d'aucune ressource).
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=
# `off` coupe les scores gradués InvokeGuardrailChecks (insultes, haine, sexuel, violence, PII, attaque de prompt).
AI_GUARDRAIL_CHECKS=
# Juge principal : rubrique de la charte, raisonnement puis sévérité 0-100 par catégorie.
# Vide = Claude Haiku 4.5 (`us.anthropic.claude-haiku-4-5-20251001-v1:0`), retenu par `npm run ai:eval`.
BEDROCK_MODEL_ID=
# Second juge (famille différente, corrobore la zone grise). Vide = Nova Lite (`us.amazon.nova-lite-v1:0`), `off` pour s'en passer.
BEDROCK_JUDGE2_MODEL_ID=
# `off` coupe les deux juges : la modération repose alors sur les règles locales et Guardrails.
AI_LLM=
