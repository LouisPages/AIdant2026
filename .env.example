# Configuration AWS. Copier ce fichier en .env.local.
# Ne jamais commiter de clés : .env.local est ignoré par git.

AWS_REGION=us-east-1
DYNAMODB_TABLE=aidants

# Clés de l'utilisateur IAM `gameday-user` (accès programmatique).
# Alternative sans clés dans le fichier : laisser vides et définir AWS_PROFILE=gameday.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Uniquement si vous utilisez des clés temporaires (ASIA...). Sinon, laisser vide.
AWS_SESSION_TOKEN=

# Réservé à la suite (recommandations avec Amazon Bedrock).
BEDROCK_MODEL_ID=
