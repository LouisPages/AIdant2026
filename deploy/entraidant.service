[Unit]
Description=entr'aidant demo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/AIdant2026
ExecStart=/usr/bin/npm start -- -H 0.0.0.0 -p 3000
Environment=AWS_REGION=us-east-1
Environment=DYNAMODB_TABLE=aidants
Environment=AI_MODE=bedrock
EnvironmentFile=-/etc/entraidant.env
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
